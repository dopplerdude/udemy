#include "main.h"

void led_effect_stop(void)
{
	for(int i = 0; i < 4; i++)
	{
		xTimerStop(handle_led_timer[i], portMAX_DELAY);
	}
}

void led_effect(int n)
{
	led_effect_stop();
	xTimerStart(handle_led_timer[n-1], portMAX_DELAY);
}

void LED_effect1()
{
	static int flag = 1;
	(flag ^= 1)?turn_off_all_leds() : turn_on_all_leds();
}


















